# ── API (FastAPI) ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key
ANTHROPIC_API_KEY=sk-ant-xxx
DATABASE_URL=postgresql://postgres:password@localhost:5432/aprendelocal
REDIS_URL=redis://localhost:6379

# Orígenes permitidos por CORS, separados por coma.
# Si se deja vacío se permite cualquier origen ("*"), lo cual solo es
# aceptable en desarrollo. En producción debe listar el dominio real.
CORS_ORIGINS=https://aprendelocal.com,https://www.aprendelocal.com

# ── Frontend (Vite) ──────────────────────────────────────────────────
# Estas van en src/frontend/.env.local en local, y en las variables de
# entorno de Vercel en producción. Vite solo expone las que empiezan
# por VITE_, y quedan embebidas en el bundle público: nunca pongas aquí
# la service_role key de Supabase ni la API key de Anthropic.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=https://api.aprendelocal.com
